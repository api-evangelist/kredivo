          "name": "Deactivate a tokenized user",
          "request": {
            "name": "Deactivate a tokenized user",
            "description": {
              "content": "Invalidates a `user_token`, ending 0-click eligibility for that shopper. A shopper can also\ndeactivate a tokenized account from the Kredivo app, in which case Kredivo sends a push\nnotification to a merchant endpoint registered with Kredivo so the merchant can invalidate\nthe token on its side.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "kredivo",
                "v2",
                "deactive_user_token"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
