        {
          "id": "53e94241-a72a-4468-8ec0-390dbc4d5fec",
          "name": "Cancel a transaction in full or in part",
          "request": {
            "name": "Cancel a transaction in full or in part",
            "description": {
              "content": "Cancels a transaction. Omitting `cancellation_amount`, or passing an amount equal to the\ntransaction amount, is a full cancellation; a smaller amount is a partial cancellation. An\namount larger than the remaining cancellable amount, or zero or negative, is rejected.\n\n`cancellation_id` is the merchant-supplied idempotency key for this operation: one order ID\nmay carry several cancellation IDs. When no `cancellation_id` is sent, Kredivo uses the pair\n(`order_id`, `cancellation_amount`) as the uniqueness key, and rejects a repeat of that same\npair if less than one hour has elapsed since the previous request.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "kredivo",
                "v2",
                "cancel_transaction"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"server_key\": \"<string>\",\n  \"order_id\": \"<string>\",\n  \"transaction_id\": \"<string>\",\n  \"cancellation_id\": \"<string>\",\n  \"cancellation_amount\": \"<integer>\",\n  \"cancellation_reason\": \"<string>\",\n  \"cancelled_by\": \"<string>\",\n  \"cancellation_date\": \"<string>\"\n}",
              "options": {
