        {
          "id": "978025dc-5fa7-4b63-aa65-2e819ea3ae62",
          "name": "Initiate a QR or EDC checkout",
          "request": {
            "name": "Initiate a QR or EDC checkout",
            "description": {
              "content": "Initiates an offline (physical store) checkout. With `source: \"QR\"` Kredivo returns a\ndynamic QR code — as an image URL or as a string, selected by `qr_type` — that the shopper\nscans in the Kredivo app. With `source: \"EDC Mobile\"` the checkout is initiated from an EDC\nterminal against the shopper's `mobile_number`.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "offline",
                "v1",
                "init_checkout"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
