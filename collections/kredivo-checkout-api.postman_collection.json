      "item": [
        {
          "id": "d09cf602-972d-43d4-b5bc-b2e5b044521e",
          "name": "Initiate a 2-click or 0-click checkout",
          "request": {
            "name": "Initiate a 2-click or 0-click checkout",
            "description": {
              "content": "Creates a Kredivo checkout for the supplied cart and returns a `redirect_url` the merchant\nsends the shopper to. Set `tokenize_user: true` with a `client_user_key` to tokenize the\nshopper for later 0-click purchases; supply an existing `user_token` to attempt a 0-click\npurchase. If the `user_token` is invalid the response still carries a `redirect_url` that\nthe merchant should follow to fall back to regular 2-click checkout.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "kredivo",
                "v2",
                "checkout_url"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"server_key\": \"<string>\",\n  \"payment_type\": \"<string>\",\n  \"transaction_details\": {\n    \"order_id\": \"<string>\",\n    \"amount\": \"<double>\",\n    \"items\": [\n      {\n        \"id\": \"<string>\",\n        \"name\": \"<string>\",\n        \"price\": \"<double>\",\n        \"quantity\": \"<integer>\",\n        \"type\": \"<string>\",\n        \"url\": \"<string>\",\n        \"image_url\": \"<string>\",\n        \"parent_type\": \"<string>\",\n        \"parent_id\": \"<string>\"\n      },\n      {\n        \"id\": \"<string>\",\n        \"name\": \"<string>\",\n        \"price\": \"<double>\",\n        \"quantity\": \"<integer>\",\n        \"type\": \"<string>\",\n        \"url\": \"<string>\",\n        \"image_url\": \"<string>\",\n        \"parent_type\": \"<string>\",\n        \"parent_id\": \"<string>\"\n      }\n    ]\n  },\n  \"customer_details\": {\n    \"first_name\": \"<string>\",\n    \"email\": \"<email>\",\n    \"phone\": \"<string>\",\n    \"last_name\": \"<string>\"\n  },\n  \"push_uri\": \"<string>\",\n  \"back_to_store_uri\": \"<string>\",\n  \"tokenize_user\": \"<boolean>\",\n  \"client_user_key\": \"<string>\",\n  \"user_token\": \"<string>\",\n  \"sellers\": [\n    {\n      \"id\": \"<string>\",\n      \"name\": \"<string>\",\n      \"email\": \"<email>\",\n      \"url\": \"<string>\",\n      \"address\": {\n        \"first_name\": \"<string>\",\n        \"address\": \"<string>\",\n        \"city\": \"<string>\",\n        \"postal_code\": \"<string>\",\n        \"phone\": \"<string>\",\n        \"country_code\": \"<string>\",\n        \"last_name\": \"<string>\"\n      },\n      \"legal_id\": \"<string>\"\n    },\n    {\n      \"id\": \"<string>\",\n      \"name\": \"<string>\",\n      \"email\": \"<email>\",\n      \"url\": \"<string>\",\n      \"address\": {\n        \"first_name\": \"<string>\",\n        \"address\": \"<string>\",\n        \"city\": \"<string>\",\n        \"postal_code\": \"<string>\",\n        \"phone\": \"<string>\",\n        \"country_code\": \"<string>\",\n        \"last_name\": \"<string>\"\n      },\n      \"legal_id\": \"<string>\"\n    }\n  ],\n  \"billing_address\": {\n    \"first_name\": \"<string>\",\n    \"address\": \"<string>\",\n    \"city\": \"<string>\",\n    \"postal_code\": \"<string>\",\n    \"phone\": \"<string>\",\n    \"country_code\": \"<string>\",\n    \"last_name\": \"<string>\"\n  },\n  \"shipping_address\": {\n    \"first_name\": \"<string>\",\n    \"address\": \"<string>\",\n    \"city\": \"<string>\",\n    \"postal_code\": \"<string>\",\n    \"phone\": \"<string>\",\n    \"country_code\": \"<string>\",\n    \"last_name\": \"<string>\"\n  },\n  \"metadata\": {\n    \"ip_address\": \"<string>\",\n    \"user_agent\": \"<string>\",\n    \"device_id\": \"<string>\",\n    \"imsi\": \"<string>\"\n  },\n  \"user_cancel_uri\": \"<string>\",\n  \"expiration_time\": \"<string>\"\n}",
